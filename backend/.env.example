NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=iot_smart_system
DB_CONNECTION_LIMIT=10

MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=iot-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_SENSOR_TOPIC=sensor/data
MQTT_CONTROL_TOPIC=device/control
MQTT_STATUS_TOPIC=device/status
MQTT_QOS=1
LIGHT_RAW_MAX=1023

ACTION_TIMEOUT_MS=10000
SENSOR_DISCONNECT_SECONDS=30
DEFAULT_USER_ID=1

PROFILE_FULL_NAME=IoT User
PROFILE_EMAIL=iot.user@example.com
PROFILE_STUDENT_ID=
